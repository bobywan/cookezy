# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=boby-boilerplate

# ──────────────────────────────────────────────
# Neon (Postgres) — catalogue des recettes
# ──────────────────────────────────────────────
# Créé depuis le Marketplace Vercel (vercel install neon).
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Clés des personnes autorisées à publier via l'API (séparées par des virgules). Serveur uniquement.
RECIPE_API_KEYS=remplace-par-une-cle-longue
# Mot de passe de la page /demandes. Au moins 12 caractères. Serveur uniquement.
ADMIN_PASSWORD=remplace-par-un-mot-de-passe-long

# ──────────────────────────────────────────────
# Auth (example)
# ──────────────────────────────────────────────
# AUTH_SECRET=your-secret-key

# ──────────────────────────────────────────────
# Proposition de recette (Resend)
# ──────────────────────────────────────────────
# Clé API Resend : https://resend.com → API Keys
RESEND_API_KEY=re_...
# Email de destination pour les propositions (le tien)
CONTACT_EMAIL=toi@example.com
# Expéditeur (domaine vérifié sur Resend, ou laisser onboarding@resend.dev en dev)
RESEND_FROM_EMAIL=onboarding@resend.dev

# ──────────────────────────────────────────────
# External APIs (example)
# ──────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
